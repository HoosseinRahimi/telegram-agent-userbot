# =====================================================================
# Telegram AI Agent Userbot - Environment Configuration Template
# =====================================================================
# Copy this file to .env and fill in your actual credentials.
# WARNING: NEVER commit your real .env file or session files to git!
# =====================================================================

# ---------------------------------------------------------------------
# 1. Telegram MTProto Credentials
# ---------------------------------------------------------------------
# Obtain these credentials from https://my.telegram.org/apps
# API ID must be a positive integer.
TELEGRAM_API_ID=12345678

# API Hash is a 32-character hexadecimal string.
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Session file name (saved as <name>.session in the project directory).
TELEGRAM_SESSION_NAME=userbot_session

# Optional: In-memory string session for stateless deployments (Docker, CI/CD).
# If provided, this overrides TELEGRAM_SESSION_NAME.
TELEGRAM_SESSION_STRING=

# ---------------------------------------------------------------------
# 2. Modular LLM Provider Configuration
# ---------------------------------------------------------------------
# Selected LLM provider backend: 'gemini', 'openai', or 'mock'
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Primary provider)
# Obtain your key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyExampleKey1234567890abcdefghijklm
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / Compatible Provider Configuration (Alternative/Local provider)
# Works with OpenAI, Ollama, LM Studio, vLLM, or other OpenAI-compatible endpoints
OPENAI_API_KEY=sk-example-openai-key-abcdefghijklmnopqrstuv
OPENAI_MODEL=gpt-4o-mini
# Optional base URL for local models (e.g. http://localhost:11434/v1 for Ollama)
OPENAI_BASE_URL=

# ---------------------------------------------------------------------
# 3. Security, Blacklist & Sensitive Filtering
# ---------------------------------------------------------------------
# Comma-separated or JSON list of user IDs or usernames to completely ignore.
# User IDs can be integers; usernames can be strings with or without '@'.
# Example: 11111111,22222222,spammer_user,ad_bot
BLACKLIST_USERS=11111111,22222222,spammer_user

# Comma-separated or JSON list of sensitive keywords that immediately halt
# auto-replies and trigger an urgent security alert dispatched to Saved Messages.
# Supports both English and Persian keywords.
SENSITIVE_KEYWORDS=otp,code,password,passcode,secret,token,private key,seed phrase,cvv,card number,کد تایید,کد ورود,رمز عبور,پسورد,رمز دوم,رمز یکبار مصرف,شماره کارت,شماره شبا

# ---------------------------------------------------------------------
# 4. Channel Monitoring & Summarization (Digest)
# ---------------------------------------------------------------------
# Comma-separated or JSON list of channel usernames or channel IDs to monitor.
# Example: tech_channel,crypto_news,-1001234567890
DIGEST_CHANNELS=tech_news_channel,ai_announcements

# Frequency interval in minutes for scheduled background digest reports.
# Default: 360 minutes (6 hours).
DIGEST_INTERVAL_MINUTES=360

# ---------------------------------------------------------------------
# 5. Agent Persona Customization
# ---------------------------------------------------------------------
# Relative or absolute path to the agent persona prompt file.
PERSONA_PROMPT_PATH=persona_prompt.txt
